# ---------------------------------------------------------------
# BookAI environment variables
# Copy this file to ".env.local" and fill in the values.
# NEVER commit .env.local or real keys to Git.
# Variables starting with NEXT_PUBLIC_ are visible in the browser;
# all others stay on the server only.
# ---------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used for webhooks & admin tasks.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Example: gemini-3.5-flash-lite (fast, recommended) or gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Facebook Messenger Platform (Meta for Developers -> your app -> Messenger)
# Any random string you choose; paste the same value in Meta's webhook settings.
MESSENGER_VERIFY_TOKEN=
# Meta app secret (App settings -> Basic). Used to verify webhook signatures.
MESSENGER_APP_SECRET=
# Optional platform-level defaults (you can also connect your Page in the dashboard)
MESSENGER_PAGE_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

# Public URL of the app, e.g. http://localhost:3000 or https://bookai.vercel.app
NEXT_PUBLIC_APP_URL=

# Optional (recommended): 32+ random characters used to encrypt stored
# Page access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
